# Copiar a .env en la raíz. Generar secretos propios; nunca subir .env.
APP_ENV=production
APP_DEBUG=false
PUBLIC_IP=192.0.2.10
APP_URL=https://192.0.2.10
ADMIN_EMAIL=operator@example.invalid
APP_KEY=
DB_CONNECTION=mysql
DB_HOST=db
DB_DATABASE=chitito
